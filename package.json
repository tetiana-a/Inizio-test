{
  "name": "inizio-serp",
  "version": "1.0.0",
  "description": "Vytažení organických výsledků z 1. strany Google pro zadané klíčové slovo + export do JSON/CSV",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "csv-parse": "^7.0.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}
