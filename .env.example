# Zdroj dat z Google – stačí jeden klíč.
# SerpApi: https://serpapi.com (250 dotazů měsíčně zdarma)
SERPAPI_API_KEY=
# Serper: https://serper.dev (2 500 dotazů zdarma při registraci)
SERPER_API_KEY=
# Volitelně vynutit poskytovatele: serpapi | serper
SERP_PROVIDER=

# Lokalizace vyhledávání (výchozí česká verze Google)
SEARCH_GOOGLE_DOMAIN=google.cz
SEARCH_GL=cz
SEARCH_HL=cs
